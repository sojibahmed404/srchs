# ==============================================================================
# Sirajganj Road Chowrasta High School - Apache Server Configuration
# ==============================================================================

# 1. Disable Directory Browsing
Options -Indexes

# 2. Follow Symbolic Links
Options +FollowSymLinks

# 3. Prevent Access to Sensitive Directories and Files
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block direct HTTP access to includes and database folders
    RewriteRule ^includes/.*$ - [F,L]
    RewriteRule ^database/.*$ - [F,L]

    # Block access to hidden files and system configs
    RewriteRule (^|/)\.(?!well-known) - [F,L]
    RewriteRule \.(sql|env|log|bak|config|dist|sh)$ - [F,L]
</IfModule>

# 4. Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5. Default Encoding
AddDefaultCharset UTF-8

# 6. PHP Configuration Overrides (where permitted by host)
<IfModule mod_php8.c>
    php_value upload_max_filesize 20M
    php_value post_max_size 25M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

# 7. Error Document Handling
# ErrorDocument 404 /index.php
# ErrorDocument 403 /index.php
